@@ -199,7 +199,7 @@
 export function keptOutcome(row: KeptRow | undefined): "kept" | "dropped" | "open" {
   if (row === undefined || row.revoked || row.state === "revoked") return "dropped";
   if (row.state !== "active") return "open";
