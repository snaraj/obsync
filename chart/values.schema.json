{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deploymentReady",
    "platform",
    "image",
    "imagePullSecrets",
    "service",
    "ingress",
    "edge",
    "trustedProxyCidrs",
    "publicUrl",
    "serverKeySecret",
    "storage",
    "retention",
    "scrubRate",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "podLabels",
    "securityContext"
  ],
  "definitions": {
    "cpuQuantity": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*(?:\\.[0-9]{1,3})?|0\\.(?:[1-9][0-9]{0,2}|0[1-9][0-9]?|00[1-9]))$"
    },
    "storageQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:Ki|Mi|Gi|Ti|Pi|Ei|k|K|M|G|T|P|E)?$"
    },
    "claimSize": {
      "description": "A claim size the SERVER is also told (OBSYNC_*_CAPACITY, chart/values.yaml). Kubernetes binary quantities only, so the one string is valid to both readers: the API server's decimal suffixes would over-state the volume by 7 per cent and make the free-space watermark fire late, and the server's own KiB/MiB/GiB/TiB spelling is not a quantity the API server accepts.",
      "type": "string",
      "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"
    },
    "kubernetesName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "labelValue": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    },
    "cidr": {
      "description": "An address block narrower than every address: a /0 trusts or admits every sender, which is no boundary at all.",
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])$|^[0-9A-Fa-f:]+/(?:[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
    },
    "peer": {
      "description": "One admitted source: a pod named by all three of its facts, or an address block.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "appName", "instance"],
          "properties": {
            "namespace": { "$ref": "#/definitions/kubernetesName" },
            "appName": { "$ref": "#/definitions/labelValue" },
            "instance": { "$ref": "#/definitions/labelValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ipBlock"],
          "properties": {
            "ipBlock": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cidr"],
              "properties": {
                "cidr": { "$ref": "#/definitions/cidr" },
                "except": { "type": "array", "items": { "$ref": "#/definitions/cidr" } }
              }
            }
          }
        }
      ]
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "size", "capacity"],
      "properties": {
        "className": { "$ref": "#/definitions/kubernetesName" },
        "size": { "$ref": "#/definitions/claimSize" },
        "capacity": { "$ref": "#/definitions/storageQuantity" }
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/cpuQuantity" },
        "memory": { "$ref": "#/definitions/storageQuantity" }
      }
    }
  },
  "properties": {
    "deploymentReady": { "type": "boolean" },
    "platform": {
      "type": "object",
      "description": "The prefix of the two platform annotations; empty renders neither. The templates judge a set value and name it when they refuse it (chart/templates/_helpers.tpl).",
      "additionalProperties": false,
      "required": ["annotationDomain"],
      "properties": { "annotationDomain": { "type": "string" } }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Any registry path, a mirror included: the required digest pins the bytes wherever they come from.",
          "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?(:[0-9]{1,5})?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)+$"
        },
        "tag": {
          "type": "string",
          "description": "Locked to appVersion by the release contract's seven-lock walk.",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "$ref": "#/definitions/kubernetesName" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": { "port": { "type": "integer", "const": 8080 } }
    },
    "ingress": {
      "type": "object",
      "description": "The deployment-provider binding point. `peers` is every admitted source; the single-peer fields name ONE connector and are accepted only all three together, because the peer namespace is shared.",
      "additionalProperties": false,
      "required": ["peers"],
      "properties": {
        "peers": { "type": "array", "items": { "$ref": "#/definitions/peer" } },
        "peerNamespace": { "$ref": "#/definitions/kubernetesName" },
        "peerAppName": { "$ref": "#/definitions/labelValue" },
        "peerInstance": { "$ref": "#/definitions/labelValue" }
      },
      "dependencies": {
        "peerNamespace": ["peerAppName", "peerInstance"],
        "peerAppName": ["peerNamespace", "peerInstance"],
        "peerInstance": ["peerNamespace", "peerAppName"]
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "type": "string", "enum": ["none", "cloudflare"] } }
    },
    "trustedProxyCidrs": {
      "type": "array",
      "items": { "$ref": "#/definitions/cidr" }
    },
    "publicUrl": { "type": "string", "pattern": "^$|^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[^\\s]*)?$" },
    "serverKeySecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "$ref": "#/definitions/kubernetesName" },
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blobs", "journal", "mirrors"],
      "properties": {
        "blobs": { "$ref": "#/definitions/volume" },
        "journal": { "$ref": "#/definitions/volume" },
        "mirrors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "className", "size", "capacity"],
            "properties": {
              "name": { "$ref": "#/definitions/kubernetesName" },
              "className": { "$ref": "#/definitions/kubernetesName" },
              "size": { "$ref": "#/definitions/storageQuantity" },
              "capacity": { "$ref": "#/definitions/storageQuantity" }
            }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "versions"],
      "properties": {
        "days": { "type": "integer", "minimum": 1 },
        "versions": { "type": "integer", "minimum": 1 }
      }
    },
    "scrubRate": { "type": "string", "pattern": "^[1-9][0-9]*(?:B|KiB|MiB|GiB)/s$" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourcePair" },
        "limits": { "$ref": "#/definitions/resourcePair" }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "operator": { "type": "string", "enum": ["Exists", "Equal"] },
          "value": { "type": "string" },
          "effect": { "type": "string", "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
          "tolerationSeconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": { "type": "object" },
        "podAffinity": { "type": "object" },
        "podAntiAffinity": { "type": "object" }
      }
    },
    "podLabels": {
      "type": "object",
      "description": "Extra pod labels. The chart's own app.kubernetes.io/* keys are refused: selectors and the NetworkPolicy match on them.",
      "propertyNames": { "not": { "pattern": "^app\\.kubernetes\\.io/" } },
      "additionalProperties": { "$ref": "#/definitions/labelValue" }
    },
    "securityContext": {
      "type": "object",
      "description": "Every field is a const: an override may restate the posture and can never weaken it (requirement 4).",
      "additionalProperties": false,
      "required": [
        "runAsNonRoot",
        "readOnlyRootFilesystem",
        "allowPrivilegeEscalation",
        "seccompProfile",
        "dropCapabilities"
      ],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "const": true },
        "readOnlyRootFilesystem": { "type": "boolean", "const": true },
        "allowPrivilegeEscalation": { "type": "boolean", "const": false },
        "seccompProfile": { "type": "string", "const": "RuntimeDefault" },
        "dropCapabilities": { "type": "string", "const": "ALL" }
      }
    }
  }
}
