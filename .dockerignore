# Keep the build context to the sources the Dockerfile actually copies, and
# keep every credential-shaped path out of it whether or not one exists today.
.git
.github
.worktrees
.claude
target
plugin/node_modules
plugin/dist
bench/results
docs
chart
scripts
*.log
**/.DS_Store
**/__pycache__
**/.env
**/.env.*
**/.npmrc
**/.ssh
**/*.agekey
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/known_hosts*
**/*credential*
**/keys.txt
**/kubeconfig*
**/*.kubeconfig
