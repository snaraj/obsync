"diff --git a/plugin/src/sync/push.ts b/plugin/src/sync/push.ts\nindex e7c3c3a7..9a4d4eed 100644\n--- a/plugin/src/sync/push.ts\n+++ b/plugin/src/sync/push.ts\n@@ -245,6 +245,14 @@ async function sendChunks(context: SyncContext, path: string, size: number, plan\n   const limit = context.host.isMobile ? PUSH_WINDOW_MOBILE_BYTES : PUSH_WINDOW_BYTES;\n   const signal = context.signal;\n   const landing = new Set<Promise<void>>();\n+  let checking: Promise<void> | null = null;\n+  let failed: { error: unknown } | undefined;\n+  const check = (): void => { if (failed !== undefined) throw failed.error; };\n+  const observe = (work: Promise<void>): Promise<void> => {\n+    const pending = work.catch((error: unknown) => { failed ??= { error }; }).finally(() => landing.delete(pending));\n+    landing.add(pending);\n+    return pending;\n+  };\n   const asked = new Set<string>();\n   let window: { sid: string; ciphertext: Bytes }[] = [];\n   let windowBytes = 0;\n@@ -261,40 +269,54 @@ async function sendChunks(context: SyncContext, path: string, size: number, plan\n         continue;\n       }\n       sent++;\n-      const upload: Promise<void> = context.transport.putChunk(sid, ciphertext, { signal }).finally(() => {\n+      observe(context.transport.putChunk(sid, ciphertext, { signal }).finally(() => {\n         held -= ciphertext.length;\n-        landing.delete(upload);\n-      });\n-      // Observed below; a stop can end it before the loop gets there.\n-      upload.catch(() => undefined);\n-      landing.add(upload);\n+      }));\n     }\n   };\n-  for await (const plaintext of chunkStream(context.host.source(path, size))) {\n-    // THE CHUNK BOUNDARY IS WHERE A STOP LANDS (issues #157, #185): nothing\n-    // after it is encrypted or sent, and what already landed is found by its\n-    // sid when the push runs again, so a folder Save or a Leave never waits\n-    // for the rest of a large upload.\n-    if (signal?.aborted === true) {\n-      // The chunks on the wire end by the same signal, at once.\n-      await Promise.allSettled(landing);\n-      throw new ApiError(0, \"cancelled\", \"sync stopped on this device\");\n+  // One existence check may overlap the next encryption window. Its bytes\n+  // stay in `held` until proved present or durably uploaded, and a rejected\n+  // check/upload remains a failure even after its promise leaves `landing`.\n+  const dispatch = async (): Promise<void> => {\n+    if (checking !== null) await checking;\n+    check();\n+    checking = observe(ask());\n+  };\n+  try {\n+    for await (const plaintext of chunkStream(context.host.source(path, size))) {\n+      // THE CHUNK BOUNDARY IS WHERE A STOP LANDS (issues #157, #185): nothing\n+      // after it is encrypted or sent, and what already landed is found by its\n+      // sid when the push runs again, so a folder Save or a Leave never waits\n+      // for the rest of a large upload.\n+      if (signal?.aborted === true) {\n+        // The chunks on the wire end by the same signal, at once.\n+        await Promise.allSettled(landing);\n+        throw new ApiError(0, \"cancelled\", \"sync stopped on this device\");\n+      }\n+      check();\n+      const { cid, sid, ciphertext } = await encryptChunk(context.domainKey, plaintext);\n+      plan.push({ sid, cid: hex(cid), len: plaintext.length });\n+      // A chunk a file repeats is asked about and sent once.\n+      if (asked.has(sid)) continue;\n+      asked.add(sid);\n+      // Half the window is asked about at once, so the other half can still be\n+      // on its way up while the next is encrypted.\n+      if (window.length > 0 && windowBytes + ciphertext.length > limit / 2) await dispatch();\n+      while (held + ciphertext.length > limit && landing.size > 0) {\n+        await Promise.race(landing);\n+        check();\n+      }\n+      window.push({ sid, ciphertext });\n+      windowBytes += ciphertext.length;\n+      held += ciphertext.length;\n     }\n-    const { cid, sid, ciphertext } = await encryptChunk(context.domainKey, plaintext);\n-    plan.push({ sid, cid: hex(cid), len: plaintext.length });\n-    // A chunk a file repeats is asked about and sent once.\n-    if (asked.has(sid)) continue;\n-    asked.add(sid);\n-    // Half the window is asked about at once, so the other half can still be\n-    // on its way up while the next is encrypted.\n-    if (window.length > 0 && windowBytes + ciphertext.length > limit / 2) await ask();\n-    while (held + ciphertext.length > limit && landing.size > 0) await Promise.race(landing);\n-    window.push({ sid, ciphertext });\n-    windowBytes += ciphertext.length;\n-    held += ciphertext.length;\n+    if (window.length > 0) await dispatch();\n+  } finally {\n+    // A check can start uploads while it settles. Drain those too, on source\n+    // failure and cancellation as well as success, before returning the slot.\n+    while (landing.size > 0) await Promise.all(landing);\n   }\n-  if (window.length > 0) await ask();\n-  await Promise.all(landing);\n+  check();\n   return sent;\n }\n \n"
